# Jametulhoda — Apache configuration (InfinityFree / cPanel / Docker, Apache 2.4+)
# router.php owns the route table: every request that is not a real file inside
# assets/ or uploads/ is handed to it, and it answers a uniform 404 for anything
# that is not a public route (including config/, includes/, pages/, bin/, tests/,
# database/, storage/ and repository files such as *.sql, *.md, *.json or .env).
# Nothing else may be served directly — a "serve any existing static file" rule
# here would publish those repository files again.
Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # RewriteBase is intentionally omitted: `router.php` is a relative substitution,
    # so Apache resolves it beside this .htaccess at both domain root and subdirectory installs.

    # 1. Trusted static assets are served directly by Apache (no PHP process).
    #    Uploaded image/audio/video files are bypassed only for a media allowlist;
    #    documents are streamed by the router as attachments, and unexpected
    #    .php/executable uploads reach the router and 404.
    #    The optional path prefix also supports a site installed in a subdirectory.
    RewriteCond %{REQUEST_URI} ^/(?:[^/]+/)*assets/ [NC]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [END]

    RewriteCond %{REQUEST_URI} ^/(?:[^/]+/)*uploads/.+\.(?:jpe?g|png|gif|webp|mp3|ogg|wav|m4a|mp4|webm|mov|mkv)$ [NC]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [END]

    # 2. The front controller itself is never rewritten again.
    RewriteRule ^router\.php$ - [END]

    # 3. Everything else (including real directories such as admin/ and any
    #    physical .php file) goes through router.php, so the route allowlist and
    #    the security gates can never be bypassed. [END] stops the per-directory
    #    rewrite loop without a second pass.
    RewriteRule ^ router.php [END,QSA]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
