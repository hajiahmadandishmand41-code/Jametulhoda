Options -Indexes -ExecCGI
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phar|pl|py|jsp|asp|aspx|shtml|sh|cgi|htm|html)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# غیرفعال کردن اجرای PHP در این پوشه به‌عنوان لایه دفاعی دوم
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
